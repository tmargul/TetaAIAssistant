{
  "policyVersion": "teta-correlation-policy-v1",
  "relationTaxonomy": [
    "exact_duplicate",
    "semantic_duplicate",
    "enrich_existing",
    "product_variant",
    "product_surface_variant",
    "version_variant",
    "temporal_variant",
    "configuration_variant",
    "process_variant",
    "scenario_variant",
    "client_variant",
    "regulatory_variant",
    "conflict",
    "unrelated",
    "requires_review"
  ],
  "semanticDuplicateMinIndependentSignals": 2,
  "allowLexicalOnlySemanticDuplicate": false,
  "allowUnknownApplicabilityAutoMerge": false,
  "allowConflictAutoResolve": false,
  "allowLocalModel": false,
  "allowEmbeddings": false,
  "allowOracleConnections": false,
  "allowApprovedRecordCreation": false,
  "folderHintAloneInsufficientForPairing": true,
  "allowedCrossKindRelations": [],
  "blockingFields": [
    "candidateKind",
    "normalizedSubject",
    "normalizedPredicate",
    "canonicalLabelTokens",
    "productFamilyIds",
    "productSurfaceIds",
    "domainIds",
    "businessAreaIds",
    "productVersionHints",
    "temporalContext",
    "clientSpecificScope",
    "correlationHints"
  ],
  "exactDuplicateAllowedDiffs": ["punctuation", "whitespace", "inflection", "technical_formatting"],
  "strict": {
    "candidateOccurrencesLost": 0,
    "evidenceOccurrencesLost": 0,
    "unrelatedKindsCompared": 0,
    "folderOnlyPairingsGenerated": 0,
    "semanticDuplicatesBasedOnlyOnLexicalSimilarity": 0,
    "semanticDuplicatesWithApplicabilityMismatch": 0,
    "conflictsAutoResolved": 0,
    "conflictingEvidenceDiscarded": 0,
    "candidateRecordsAutoApprovedFromLexicon": 0,
    "ambiguousCorrelationsAutoResolved": 0,
    "graphCorrelationOracleConnections": 0,
    "leadingZeroIdentifiersLost": 0,
    "customerExampleClaimsPromotedToGlobal": 0,
    "localModelCalls": 0,
    "remoteModelCalls": 0
  }
}
