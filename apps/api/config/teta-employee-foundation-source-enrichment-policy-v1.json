{
  "policyId": "teta-employee-foundation-source-enrichment",
  "policyVersion": "teta-aia-employee-foundation-source-enrichment-policy-v1",
  "description": "Candidate-scoped offline source enrichment policy. Not approval. Not reuse. Preview graph cannot become active.",
  "viewDefinitionCompletenessRequired": true,
  "unsupportedConstructsBlockKeyPreservation": true,
  "candidateScopedAllowlistRequired": true,
  "partialDataSurfaceNotConfirmed": true,
  "ambiguousDataSurfaceRequiresSelection": true,
  "rawTechnicalMetadataContainment": true,
  "previewGraphCannotBecomeActive": true,
  "syntheticArtifactsExcludedFromRealAssessment": true,
  "missingArtifactIsFailClosedNotFailure": true,
  "notParsedMeansNotEvaluated": true,
  "zeroCandidatesAreNotUnambiguous": true,
  "activeGraphImmutabilityRequiresContentHash": true,
  "validatedPreviewRequiresNonEmptyDelta": true,
  "allowlistRequiresObservedBounds": true,
  "syntheticAndRealMetricsSeparated": true,
  "requestAvailabilityDoesNotProveSemanticAttribution": true,
  "provenRequiresCompleteness": ["complete", "fragmented_complete"],
  "provenRequiresParseStatus": "parsed",
  "maxIncompleteKeyPreservation": "supported_partial",
  "missingDefinitionYields": "not_evaluable",
  "dependsOnPlusBasePkMaxStatus": "supported_partial",
  "firstSliceTargets": ["P1"],
  "deferredTargets": ["P2", "P6", "P7", "training_participant"],
  "collectorBounds": {
    "maxDepth": 4,
    "maxNodes": 80,
    "maxEdges": 160,
    "maxCandidates": 20
  },
  "allowedNodeTypes": [
    "application_form",
    "application_control",
    "business_object",
    "dataset",
    "data_source",
    "gateway",
    "join",
    "oracle_object",
    "oracle_column",
    "help_field"
  ],
  "allowedEdgeTypes": [
    "HAS_CONTROL",
    "USES_BO",
    "USES_DF",
    "USES_DATASOURCE",
    "PRODUCES_DATASET",
    "RESOLVES_TO_GATEWAY",
    "JOINS_TO",
    "MAPS_TO_ORACLE_OBJECT",
    "BINDS_TARGET",
    "HAS_COLUMN",
    "DEPENDS_ON",
    "PRIMARY_KEY_OF",
    "UNIQUE_KEY_OF"
  ],
  "prohibitedFallbacks": [
    "similar_view_name",
    "global_view_scan",
    "global_column_scan",
    "prac_employee_karta_search",
    "unanchored_shortest_path"
  ],
  "rulesApplied": [
    "notParsedMeansNotEvaluated",
    "zeroCandidatesAreNotUnambiguous",
    "activeGraphImmutabilityRequiresContentHash",
    "validatedPreviewRequiresNonEmptyDelta",
    "allowlistRequiresObservedBounds",
    "syntheticAndRealMetricsSeparated",
    "requestAvailabilityDoesNotProveSemanticAttribution",
    "viewDefinitionCompletenessRequired",
    "unsupportedConstructsBlockKeyPreservation",
    "candidateScopedAllowlistRequired",
    "partialDataSurfaceNotConfirmed",
    "ambiguousDataSurfaceRequiresSelection",
    "rawTechnicalMetadataContainment",
    "previewGraphCannotBecomeActive",
    "syntheticArtifactsExcludedFromRealAssessment",
    "missingArtifactIsFailClosedNotFailure"
  ],
  "failClosed": {
    "approvalForbidden": true,
    "genericActivationForbidden": true,
    "planningForbidden": true,
    "activeGraphPromotionForbidden": true,
    "sqlExecutionForbidden": true
  }
}
